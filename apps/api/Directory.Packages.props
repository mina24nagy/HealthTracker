<Project>
  <!-- Central Package Management: every NuGet version is declared once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <!-- Keep Microsoft.AspNetCore.* on the 10.0.x line to match the .NET 10 LTS runtime. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (opted in via global.json), so no VSTest packages are needed. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
