{
  "name": "@healthtracker/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client generated from the API's OpenAPI spec (generation added in #5)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
