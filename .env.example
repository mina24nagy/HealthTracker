# Copy to .env (git-ignored) to override the local-development defaults in compose.yaml.
# If you change the PostgreSQL values, update ConnectionStrings:HealthTracker for runs outside Docker too
# (e.g. `dotnet user-secrets` on apps/api/src/HealthTracker.Api, or the ConnectionStrings__HealthTracker env var).

POSTGRES_DB=healthtracker
POSTGRES_USER=healthtracker
POSTGRES_PASSWORD=healthtracker_dev
POSTGRES_PORT=5432
API_PORT=5080
